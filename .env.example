# Copy this file to .env.local / .env.staging / .env.production and fill in real values.
# Never commit the filled-in files — they are already git-ignored.
# Loaded by helpers/config.ts based on TEST_ENV (defaults to "local").

# ── Frontend base URLs ──────────────────────────────────────────────
ADMIN_BASE_URL=
CLIENT_BASE_URL=

# ── Backend microservice base URLs (one per service, no shared gateway) ──
# Local defaults matching each service's own `process.env.PORT || <default>`
# are noted alongside each — adjust to match your local pm2/dev setup.
SIGNUP_LOGIN_API=          # signup-login-backend, default port 8080
ACCOUNT_CONTACT_API=       # account-contact-backend, default port 8080 (collides with signup-login default — set explicitly)
ACCOUNT_NOTE_API=          # account-note-backend, default port 8014
ACCOUNT_TASKS_API=         # account-task-backend, default port 8013
JOBS_API=                  # jobs-backend, default port 8008
INVOICE_API=               # invoice-backend, default port 8003
PROPOSAL_API=              # proposal-backend, default port 8023
ESIGNATURE_API=            # esignature-backend, default port 8016
FOLDER_MANAGEMENT_API=     # folder-mangement, default port 8020
INTERNAL_COMMUNICATION_API= # internal-communication, default port 8017
ORGANIZER_API=             # organizer-backend, default port 8007
TEMPLATES_API=             # templates-backend, default port 8002
CHAT_API=                  # chat-backend, default port 8010
SIDEBAR_API=               # sidebar-backend, default port 8024
CLIENT_SIDEBAR_API=        # client-sidebar-backend, default port 8012

# ── QA identity: two isolated tenants, admin + client role in each ───
QA_TENANT_A=
QA_TENANT_B=

QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

QA_ADMIN_B_EMAIL=
QA_ADMIN_B_PASSWORD=

QA_CLIENT_EMAIL=
QA_CLIENT_PASSWORD=

QA_CLIENT_B_EMAIL=
QA_CLIENT_B_PASSWORD=

# QA_CLIENT_ACCOUNT_ID / QA_CLIENT_B_ACCOUNT_ID: the accountId the client
# contact selects after login (client app requires token AND accountId).
QA_CLIENT_ACCOUNT_ID=
QA_CLIENT_B_ACCOUNT_ID=

# ── Safety ────────────────────────────────────────────────────────────
# local | staging | production — production runs are auto-restricted to
# read-only/smoke behavior by helpers/config.ts regardless of this flag.
TEST_ENV=local
